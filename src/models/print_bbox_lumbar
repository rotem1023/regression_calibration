import os
import numpy as np
import torch
from torch.utils.data import Dataset
import torchvision.transforms as transforms
from skimage import io
import cv2
from PIL import Image, ImageDraw
import load_trained_models
import math

class Bbox():
    def __init__(self, x_minus, x_plus, y_minus, y_plus):
        self.x_minus = x_minus
        self.x_plus = x_plus
        self.y_minus = y_minus
        self.y_plus = y_plus


class LumbarDataset(Dataset):
    """
    Loads the EndoVis instrument tracking dataset with bounding boxes.
    """

    def __init__(self, level, mode='train', scale=1.0, augment=False):
        self._scale = scale
        self._level = level

        # get current file dir
        current_dir = os.path.dirname(os.path.abspath(__file__))
        idx_dir = os.path.join(current_dir, 'data')
        self.data_dir = idx_dir
        idx_file = os.path.join(idx_dir, f'L{level}.txt')

        # read the index file
        with open(idx_file, 'r') as f:
            self._img_file_names = f.readlines()
            n = len(self._img_file_names)
            self._img_file_names = [x.strip() for x in self._img_file_names]

            # split the data into train, val, test
            if mode == 'train':
                self._img_file_names = self._img_file_names[:int(n * 0.6)]
            elif mode == 'val':
                self._img_file_names = self._img_file_names[int(n * 0.6):int(n * 0.8)]
            else:
                self._img_file_names = self._img_file_names[int(n * 0.8):]
        
        
        base_model = 'efficientnetb4'
        base_model_dist = 'resnet50'
        assert base_model in ['resnet101', 'densenet201', 'efficientnetb4']
        self.device = torch.device("cuda:1")
        loss = 'gaussian'
        one_output = False
        lambda_param = 1
        level = 1
        self.model_x = load_trained_models.get_model_lumbar(base_model, level, None, self.device, loss=loss)
        self.dist_model_x = load_trained_models.get_model_lumbar(base_model_dist, level, base_model, self.device, lambda_param=lambda_param, one_out=one_output, loss=loss)
        self.model_y = load_trained_models.get_model_lumbar(base_model, level, None, self.device, loss=loss)
        self.dist_model_y = load_trained_models.get_model_lumbar(base_model_dist, level, base_model, self.device, lambda_param=lambda_param, one_out=one_output, loss=loss)
        self.q_x_my_model = 0
        self.q_y_my_model = 0
        self.q_x_cp =  1
        self.q_y_cp = 1       
    
    def _calc_b_box(self, x):
        x = x.to(self.device)
        mu_x, logvar_x  = self.model_x(x, dropout=False, mc_dropout=False, test=False)
        mu_y, logvar_y = self.model_y(x, dropout=False, mc_dropout=False, test=False)
        
        mu_x, mu_y, logvar_x, logvar_y = mu_x.detach(), mu_y.detach(), logvar_x.detach(), logvar_y.detach()
        distance_x =self.dist_model_x(x).detach()
        neg_dist_x, pos_dist_x = distance_x[0], distance_x[1]
        x_minus = mu_x - neg_dist_x - self.q_x_my_model
        x_plus = mu_x + pos_dist_x + self.q_x_my_model
        
        distance_y =self.dist_model_y(x).detach()
        neg_dist_y, pos_dist_y = distance_y[0], distance_y[1]
        y_minus = mu_y - neg_dist_y -self.q_y_my_model
        y_plus  = mu_y + pos_dist_y + self.q_y_my_model
        
        bbox_my = Bbox(x_minus=x_minus, x_plus=x_plus, y_minus=y_minus, y_plus=y_plus)
        
        sd_x, sd_y = math.sqrt(math.exp(logvar_x)), math.sqrt(math.exp(logvar_y))
        
        x_minus = mu_x - sd_x * self.q_x_cp
        x_plus = mu_x + sd_x + self.q_x_my_cp
        
        y_minus = mu_y - sd_y * self.q_y_cp
        y_plus = mu_y + sd_y * self.q_y_cp
        
        bbox_cp = Bbox(x_minus=x_minus, x_plus=x_plus, y_minus=y_minus, y_plus=y_plus)
        
        return bbox_my, bbox_cp, mu_x, mu_y
        
            
            
            
            
    
    @staticmethod
    def to_pil_and_resize(x, scale):
        w, h, _ = x.shape
        new_size = (int(w * scale), int(h * scale))
        target_size = (224, 224)

        trans_always1 = [
            transforms.ToPILImage(),
            transforms.Resize(target_size),
        ]

        trans = transforms.Compose(trans_always1)
        x = trans(x)
        return x

    def __len__(self):
        return len(self._img_file_names)

    def __getitem__(self, idx):
        trans_always2 = [transforms.ToTensor()]
        trans = transforms.Compose(trans_always2)
        
        filename_values = self._img_file_names[idx]
        split_val = filename_values.split(',')

        img_path = os.path.join(self.data_dir, split_val[0])
        x = io.imread(img_path)
        x = np.atleast_3d(x)

        # Convert grayscale to RGB
        if x.shape[2] == 1:
            x = np.repeat(x, 3, axis=2)

        # Convert to PIL and resize
        x = self.to_pil_and_resize(x, self._scale)

        # Extract bounding box coordinates from file (assumed format: x_min, y_min, x_max, y_max)
        my_bbox, cp_bbbox, mu = self._calc_b_box(trans(x))

        # Draw bounding box
        my_image = self.draw_bounding_box(x, my_bbox)
        cp_image = self.draw_bounding_box(x, cp_bbbox)
        
        my_image.save(f"{img_path.split('/')[-1]}_my_image.jpg")
        cp_image.save(f"{img_path.split('/')[-1]}_cp_image.jpg")
        x = trans(x)

        return x

    def draw_bounding_box(self, image, bbox):
        """
        Draws a bounding box on the given PIL image.

        :param image: PIL Image
        :param bbox: Bounding box [x_min, y_min, x_max, y_max]
        :return: PIL Image with bounding box
        """
        draw = ImageDraw.Draw(image)
        draw.rectangle(bbox.tolist(), outline="red", width=3)
        return image
